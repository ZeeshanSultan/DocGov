#!/usr/bin/env node
/**
 * docgov — documentation governance engine.
 *
 * One binary serves three callers: Claude Code skills (via `--json`), Claude Code
 * hooks (via `docgov hook <event>` speaking the hook JSON protocol on stdin/stdout),
 * and CI (via exit codes). Keeping them on one implementation is why a governance
 * decision cannot differ between the editor and the pipeline.
 *
 * This file is the dispatcher and nothing else. It used to be the whole CLI — 1,400 lines of
 * parsing, formatting, every command and the entire hook protocol, with `flags` and `JSONOUT`
 * as module globals that every function could reach and no signature mentioned. That made it
 * the one file in the repository a mechanical edit could not be trusted on: command names
 * collided with local identifiers, so a rename by search-and-replace produced duplicate
 * bindings rather than an error. Commands now take their flags as an argument, and output
 * mode is set once here instead of read from a global.
 */
import process from 'node:process';

import { EXIT, DocGovError } from '../core/util.js';
import { FLAG_ALIASES, parseFlags } from '../cli/parse.js';
import * as out from '../cli/output.js';
import { packageVersion } from '../cli/context.js';
import { usage } from '../cli/usage.js';
import { cmdHook } from '../cli/hooks.js';
import { cmdSetup, cmdReview, cmdFix, cmdTag } from '../cli/commands/adopt.js';
import { cmdWhatis, cmdCreate, cmdBrief, cmdFind, cmdTypes } from '../cli/commands/author.js';
import { cmdCheck, cmdStale, cmdAffected, cmdChecklist, cmdHealth, cmdPublish, cmdInspect,
  cmdIgnore, cmdJudge, cmdDoctor } from '../cli/commands/verify.js';
import { cmdRegistry, cmdGraph, cmdRules, cmdTools } from '../cli/commands/state.js';

const argv = process.argv.slice(2);
const cmd = FLAG_ALIASES[argv[0]] || argv[0];
const flags = parseFlags(argv.slice(1));

// Output mode is decided once, before anything can print. Every writer in cli/output.js
// honours it, so no command has to remember to check a flag — which is how a stray log line
// ends up inside a JSON payload a skill is parsing.
out.configure({ json: flags.json === true, compact: flags.compact === true });

const COMMANDS = {
  setup: cmdSetup,
  review: cmdReview,
  fix: cmdFix,
  whatis: cmdWhatis,
  tag: cmdTag,
  create: cmdCreate,
  check: cmdCheck,
  stale: cmdStale,
  affected: cmdAffected,
  checklist: cmdChecklist,
  brief: cmdBrief,
  find: cmdFind,
  health: cmdHealth,
  publish: cmdPublish,
  registry: cmdRegistry,
  graph: cmdGraph,
  rules: cmdRules,
  types: cmdTypes,
  tools: cmdTools,
  ignore: cmdIgnore,
  judge: cmdJudge,
  doctor: cmdDoctor,
  inspect: cmdInspect,
  hook: cmdHook,
  version: () => { out.say(packageVersion()); return EXIT.OK; },
  help: usage,
};

// Set process.exitCode rather than calling process.exit(). When stdout is a pipe, writes
// are asynchronous, and process.exit() discards whatever has not flushed yet — which
// truncated any output over the pipe buffer (8 KB) on Node 20. `docgov types --json` is
// larger than that, so piping it produced JSON that ended mid-string. Node exits with this
// code on its own once the event loop drains, which is after stdout has flushed.
try {
  const fn = COMMANDS[cmd];
  if (!fn) {
    usage();
    process.exitCode = cmd ? EXIT.CONFIG : EXIT.OK;
  } else {
    process.exitCode = fn(flags) ?? EXIT.OK;
  }
} catch (e) {
  if (e instanceof DocGovError) {
    if (out.json()) console.log(JSON.stringify({ error: e.message }));
    else console.error(`docgov: ${e.message}`);
    process.exitCode = e.code ?? EXIT.CONFIG;
  } else {
    if (out.json()) console.log(JSON.stringify({ error: String(e.message || e) }));
    else console.error(`docgov: unexpected error: ${e.stack || e}`);
    process.exitCode = EXIT.CONFIG;
  }
}
